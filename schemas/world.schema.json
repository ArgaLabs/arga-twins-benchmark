{
  "$defs": {
    "IdentitySpec": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "IdentitySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
