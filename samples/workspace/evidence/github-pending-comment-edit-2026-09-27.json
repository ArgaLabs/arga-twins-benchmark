  "corrections": [
    "Existing duplicate-reply assertion counted both visible text and hidden edit textarea. Updated it to count the rendered paragraph; full regression suite passed.",
    "Added an explicit comment-author condition to editor visibility after local Chrome verification, covered by automated authorization checks.",
    "Rebased onto #1230 to inherit ambiguous-error locking; 48 affected tests pass after rebase.",
    "Review identified that unopened prefilled editors were preserved as local drafts. Compare textarea value with defaultValue; preserve opened, focused or changed drafts and refresh untouched editors. A failing regression and real browser concurrent-edit test demonstrate the correction.",
    "Hosted #1230 AX activation hid a locked label-based composer. Replaced Cancel with a native button, with reset/focus and disabled-state handling. Local 390px AX cancellation, uncertain lock and Escape checks pass."
  ],
  "limits": [
    "Bounded desktop and 390px hosted workflows, full eight-provider state and all ten worker/two serving image checks pass.",
    "Live GitHub visual comparison, published-comment editing, suggestions and broader review/AI/collaboration gates remain open. Multiline review selection is tracked by #1232.",
    "No exhaustive visual or physical-touch coverage claimed; full release remains blocked."
  ],
