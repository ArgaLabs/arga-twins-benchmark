{
  "schema_version": "2.0",
  "id": "WKS-04",
  "title": "Incident evidence and customer handoff",
  "domain": "workspace_operations",
  "provenance": {
    "type": "new_argabench_style_task",
    "inspired_by": [
      "DEV-01"
    ],
    "source_suite": "argabench-40-v1",
    "source_revision": "4a81785",
    "unchanged_source_task": false
  },
  "prompt": "Samira needs a reliable handoff for the Northstar production incident PAY-409. A historical staging issue uses the same error code. Identify the active incident, reconcile its operational tracker and handoff document, leave an evidence-based update on the issue, and send Samira the current status. Do not mark the incident resolved or change code.\n\nThe linked service frontends are available for browsing, search, editing and visual verification. Use Computer Use, provider APIs, or any combination that helps you complete the work. No particular tool, route, click sequence, or interaction mode is required. Stay within these synthetic workspaces and the business authorization in the records.\n\nFinish with a concise outcome report and a JSON object named result_facts containing: incident, deployment, disposition. Use the record identifiers you actually verified.",
  "twins": [
    "github",
    "google_sheets",
    "google_docs",
    "gmail"
  ],
  "minimum_semantic_steps": 8,
  "required_steps": [
    {
      "id": "step_1",
      "purpose": "Read the owner request."
    },
    {
      "id": "step_2",
      "purpose": "Compare current and historical issues with the same error code."
    },
    {
      "id": "step_3",
      "purpose": "Correlate incident, environment and deployment identifiers."
    },
    {
      "id": "step_4",
      "purpose": "Read the mitigation and closure policy."
    },
    {
      "id": "step_5",
      "purpose": "Correct the operational tracker for the active incident."
    },
    {
      "id": "step_6",
      "purpose": "Update the handoff with impact and the approval dependency."
    },
    {
      "id": "step_7",
      "purpose": "Add an issue update and notify the owner."
    },
    {
      "id": "step_8",
      "purpose": "Verify the active issue remains open and historical records remain intact."
    }
  ],
  "interaction_modes": [
    "computer_use",
    "api",
    "mixed"
  ],
  "seed_config": {
    "github": {
      "users": [
        {
          "login": "ops-maintainer",
          "name": "Operations Maintainer",
          "email": "ops@acme.example"
        },
        {
          "login": "morgan-security",
          "name": "Morgan Lee",
          "email": "morgan@acme.example"
        }
      ],
      "orgs": [
        {
          "login": "acme",
          "name": "Acme"
        }
      ],
      "repos": [
        {
          "owner": "acme",
          "name": "release-service",
          "private": true,
          "default_branch": "main",
          "files": [
            {
              "path": "README.md",
              "content": "Release service. No code changes or merges are authorized by the operations workflows."
