          ],
          "issues": [
            {
              "title": "Northstar production PAY-409",
              "body": "Active production incident INC-204. Deployment DEP-9842 caused duplicate idempotency keys. Owner: Morgan Lee. Mitigation is awaiting approval; impact continues.",
              "state": "open"
            },
            {
              "title": "Staging PAY-409 fixture investigation",
              "body": "Historical staging-only error from July. Resolved; unrelated to DEP-9842.",
              "state": "closed"
            }
          ],
          "prs": []
        }
      ]
    },
    "google_sheets": {
      "spreadsheets": [
        {
          "title": "Incident operations tracker",
          "sheets": [
            {
              "title": "Current",
              "values": [
                [
                  "Incident",
                  "Environment",
                  "Deployment",
                  "Status",
                  "Owner"
                ],
                [
                  "INC-204",
                  "production",
                  "",
                  "Triage",
                  ""
                ],
                [
                  "INC-101",
                  "staging",
                  "DEP-7000",
                  "Resolved",
                  "Alex"
                ]
              ]
            },
            {
              "title": "Archive",
              "values": [
                [
                  "Reference",
                  "Status"
                ],
                [
                  "Previous cycle",
                  "Closed"
                ]
              ]
            }
          ]
        }
      ]
    },
    "google_docs": {
      "documents": [
        {
          "title": "Northstar incident handoff",
          "content": "Northstar incident handoff\nIncident INC-204\nCurrent impact and next action are awaiting triage."
        },
        {
          "title": "Incident handling policy",
          "content": "An incident stays open while impact continues. Keep approved mitigation separate from proposed work. Only the incident commander can authorize mitigation, deployment, or closure. The handoff must distinguish the production deployment from historical staging errors."
        }
      ]
    },
    "gmail": {
      "base_time": "2026-09-22T12:00:00Z",
      "messages": [
        {
          "subject": "Northstar incident handoff",
          "body": "Please correlate PAY-409 with the correct production deployment, reconcile the tracker and handoff, add the current findings on the active issue, and send only me the verified status. No fix or mitigation has been approved.",
          "from": "samira@acme.example",
          "to": "owner@gmail-twin.local",
          "date": "2026-09-22T09:00:00Z"
        }
      ]
    }
  },
  "verification": {
    "schema_version": "workspace-outcomes/1",
    "grading_basis": "observable_business_outcomes",
    "required_outcomes": [
      {
        "provider": "github",
        "kind": "issue_comment",
        "selector": {
          "issue_title": "Northstar production PAY-409"
        },
        "expected": {
          "contains_all": [
            "INC-204",
            "DEP-9842"
          ],
          "semantic_groups": [
            [
              "approval",
              "approved"
            ],
            [
              "pending",
              "awaiting",
              "continues",
              "open"
            ]
          ]
        }
      },
      {
        "provider": "google_sheets",
        "kind": "row",
        "selector": {
          "title": "Incident operations tracker",
          "sheet": "Current",
          "key": "INC-204"
        },
        "expected": {
          "cells": {
            "C2": "DEP-9842",
            "D2": [
              "open",
              "awaiting approval",
              "pending mitigation"
            ],
            "E2": [
              "Morgan Lee",
              "morgan-security"
            ]
          }
        }
      },
