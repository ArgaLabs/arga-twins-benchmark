            ]
          ]
        }
      },
      {
        "provider": "gmail",
        "kind": "sent_message",
        "selector": {
          "to": "samira@acme.example"
        },
        "expected": {
          "contains_all": [
            "INC-204",
            "DEP-9842"
          ],
          "semantic_groups": [
            [
              "approval",
              "approved"
            ]
          ]
