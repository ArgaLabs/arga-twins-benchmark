  },
  "prompt": "The Northstar readiness meeting needs to move after a customer correction. Reconcile the latest email, the existing calendar event, and the readiness tracker. Choose the authorized conflict-free slot, update the existing meeting and tracker, and confirm the corrected schedule to Samira. Preserve the attendee list and unrelated meetings.\n\nThe linked service frontends are available for browsing, search, editing and visual verification. Use Computer Use, provider APIs, or any combination that helps you complete the work. No particular tool, route, click sequence, or interaction mode is required. Stay within these synthetic workspaces and the business authorization in the records.\n\nFinish with a concise outcome report and a JSON object named result_facts containing: reference, start_utc, end_utc. Use the record identifiers you actually verified.",
  "twins": [
    "gmail",
    "google_calendar",
    "google_sheets"
  ],
  "minimum_semantic_steps": 7,
  "required_steps": [
    {
      "id": "step_1",
      "purpose": "Compare the initial and corrected availability messages."
    },
    {
      "id": "step_2",
      "purpose": "Locate the right customer event and preserve its details."
    },
    {
      "id": "step_3",
      "purpose": "Inspect calendar conflicts for both proposed windows."
    },
    {
      "id": "step_4",
      "purpose": "Select the earliest feasible authorized time."
    },
    {
      "id": "step_5",
      "purpose": "Reschedule the existing event without duplicating it."
    },
    {
      "id": "step_6",
      "purpose": "Update only the matching readiness row."
    },
    {
      "id": "step_7",
      "purpose": "Send the owner a confirmation and verify all three systems."
    }
  ],
  "interaction_modes": [
    "computer_use",
    "api",
    "mixed"
  ],
