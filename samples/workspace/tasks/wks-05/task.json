              "path": "README.md",
              "content": "Release service. No code changes or merges are authorized by the operations workflows."
            },
            {
              "path": "CODEOWNERS",
              "content": "/auth/ @morgan-security\n"
            }
          ],
          "issues": [
            {
              "title": "v2.4 rollback validation",
              "body": "Release blocker BLK-204: rollback validation has not passed. Owner Morgan Lee; next verification ETA 2026-09-24 18:00 UTC. Keep open until the owner attaches passing evidence.",
              "state": "open"
            },
            {
              "title": "v2.3 rollback validation",
              "body": "Prior release blocker BLK-103 passed and was closed.",
              "state": "closed"
            }
          ],
          "prs": []
        }
      ]
    },
    "gmail": {
      "base_time": "2026-09-22T12:00:00Z",
      "messages": [
        {
          "subject": "v2.4 launch readiness decision",
          "body": "Review the release criteria and current blocker evidence. If blocked, convert the existing 15:00 UTC launch decision meeting to a readiness review at the earliest Operations-calendar slot after the owner\u2019s verification ETA. Slots available to participants are 18:00-18:30 or 19:00-19:30 UTC on 24 September. Preserve the attendee list and keep the review linked to the same release. Reply only to me.",
          "from": "samira@acme.example",
          "to": "owner@gmail-twin.local",
          "date": "2026-09-22T09:00:00Z"
        }
      ]
    },
    "google_docs": {
      "documents": [
        {
          "title": "v2.4 launch brief",
          "content": "Release v2.4\nDecision: pending.\nRecord the blocker, accountable owner, and revised readiness review."
        },
        {
          "title": "Release go/no-go criteria",
          "content": "A launch is blocked while any release blocker is open. A historical closed blocker is not current evidence. An ETA is not a passing result. Schedule a readiness review after the ETA and around existing calendar conflicts; do not announce a launch."
        }
      ]
    },
