{
  "schema_version": "2.0",
  "id": "WKS-05",
  "title": "Launch readiness decision across workspaces",
  "domain": "workspace_operations",
  "provenance": {
    "type": "new_argabench_style_task",
    "inspired_by": [
      "DEV-01",
      "DEV-05"
    ],
    "source_suite": "argabench-40-v1",
    "source_revision": "4a81785",
    "unchanged_source_task": false
  },
  "prompt": "Prepare the v2.4 launch decision for Samira across the release workspaces. The planned launch is on 24 September, but a release-blocking issue may still be open. Determine whether the recorded launch criteria are met. Reconcile the release tracker, launch brief and existing decision meeting, record the dependency on the issue, and send Samira the verified decision. Do not merge, deploy, close issues, cancel unrelated meetings, or announce a customer launch.\n\nThe linked service frontends are available for browsing, search, editing and visual verification. Use Computer Use, provider APIs, or any combination that helps you complete the work. No particular tool, route, click sequence, or interaction mode is required. Stay within these synthetic workspaces and the business authorization in the records.\n\nFinish with a concise outcome report and a JSON object named result_facts containing: release, blocker, decision, review_utc. Use the record identifiers you actually verified.",
  "twins": [
    "github",
    "gmail",
    "google_docs",
    "google_sheets",
    "google_calendar"
  ],
  "minimum_semantic_steps": 9,
  "required_steps": [
    {
      "id": "step_1",
      "purpose": "Read the launch request and go/no-go criteria."
    },
    {
      "id": "step_2",
      "purpose": "Distinguish current and historical blocker evidence."
    },
    {
      "id": "step_3",
      "purpose": "Resolve the accountable owner and verification ETA."
    },
    {
      "id": "step_4",
      "purpose": "Inspect scheduling conflicts and choose the first feasible review window."
    },
    {
      "id": "step_5",
      "purpose": "Update the current release tracker with blocked status and review time."
    },
    {
      "id": "step_6",
      "purpose": "Reconcile the launch brief with blocker evidence and dependencies."
    },
    {
      "id": "step_7",
      "purpose": "Move and relabel the existing decision meeting."
    },
    {
      "id": "step_8",
      "purpose": "Record the dependency on the current issue and notify the owner."
    },
    {
      "id": "step_9",
      "purpose": "Verify all five workspaces and preserve unrelated records."
    }
  ],
  "interaction_modes": [
    "computer_use",
    "api",
    "mixed"
  ],
  "seed_config": {
    "github": {
      "users": [
        {
          "login": "ops-maintainer",
          "name": "Operations Maintainer",
          "email": "ops@acme.example"
        },
        {
          "login": "morgan-security",
          "name": "Morgan Lee",
          "email": "morgan@acme.example"
